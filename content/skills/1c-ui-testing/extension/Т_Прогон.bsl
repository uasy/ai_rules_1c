// Инфраструктура прогона в сеансе менеджера тестирования: параметры запуска, протокол,
// подключение к клиенту тестирования и выполнение серверного кода проверяемой базы через
// HTTP-сервис Dbg_Executor (навык 1c-test-debug).
//
// Модуль поставляется навыком и укладывается в тестовое расширение сборщиком
// build-test-extension.py клиентским общим модулем. Серверные шаги лежат текстовыми макетами
// обработки своего теста, поэтому сценарию не нужен доступ к каталогу тестов.

#Область ПрограммныйИнтерфейс

// Возвращает параметры прогона, разобранные из параметра запуска сеанса:
// "УИМенеджер|<порт клиента>|<адрес клиента>|<файл протокола>|<корень проекта>|
// <адрес публикации>|<имя теста>".
//
// Возвращаемое значение:
//  Структура:
//   * Тест            - Строка - имя теста, который выполняет прогон.
//   * Порт            - Число - порт клиента тестирования.
//   * АдресКлиента    - Строка - адрес клиента тестирования.
//   * ФайлПротокола   - Строка - файл протокола, его читает раннер.
//   * КореньПроекта   - Строка - каталог проекта, из него читается .dev.env.
//   * АдресПубликации - Строка - публикация проверяемой базы.
//   * Обработка         - Строка - имя обработки теста в расширении; подставляет диспетчер.
//   * Протокол        - Массив из Строка - записанные шаги.
//   * ЕстьОшибки      - Булево - был ли шаг с отказом.
//   * Настройки       - Структура, Неопределено - параметры сервиса, читаются при первом обращении.
Функция Контекст() Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Порт", ?(ПустаяСтрока(Элемент(1)), 0, Число(Элемент(1))));
	Контекст.Вставить("АдресКлиента", Элемент(2));
	Контекст.Вставить("ФайлПротокола", Элемент(3));
	Контекст.Вставить("КореньПроекта", Элемент(4));
	Контекст.Вставить("АдресПубликации", Элемент(5));
	Контекст.Вставить("Тест", Элемент(6));
	Контекст.Вставить("Обработка", "");
	Контекст.Вставить("Протокол", Новый Массив);
	Контекст.Вставить("ЕстьОшибки", Ложь);
	Контекст.Вставить("Настройки", Неопределено);

	Возврат Контекст;

КонецФункции

// Добавляет шаг в протокол и переписывает файл протокола целиком: при снятии сеанса
// по таймауту записанные шаги показывают, где прогон остановился.
//
// Параметры:
//  Контекст - Структура - см. Контекст.
//  Успех    - Булево - результат шага.
//  Текст    - Строка - описание шага.
Процедура ЗаписатьШаг(Контекст, Успех, Текст) Экспорт

	Контекст.Протокол.Добавить(?(Успех, "[OK] ", "[FAIL] ") + Текст);
	Если НЕ Успех Тогда
		Контекст.ЕстьОшибки = Истина;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(Контекст.ФайлПротокола, "UTF-8");  // noqa: BSL188
	Для Каждого Строка Из Контекст.Протокол Цикл
		Запись.ЗаписатьСтроку(Строка);
	КонецЦикла;
	Запись.Закрыть();

КонецПроцедуры

// Записывает итоговую строку прогона: её ищет раннер, чтобы отличить пройденный прогон
// от прерванного на середине.
//
// Параметры:
//  Контекст - Структура - см. Контекст.
Процедура ЗавершитьПрогон(Контекст) Экспорт

	ЗаписатьШаг(Контекст, НЕ Контекст.ЕстьОшибки,
		?(Контекст.ЕстьОшибки, "ПРОГОН ЗАВЕРШЁН С ОШИБКАМИ", "ПРОГОН ПРОЙДЕН"));

КонецПроцедуры

// Подключается к клиенту тестирования, повторяя попытки до истечения таймаута.
//
// Параметры:
//  Контекст - Структура - см. Контекст.
//  Таймаут  - Число - предельное время ожидания, секунд; у большой ИБ клиент открывает
//             TCP-порт раньше, чем становится готов принять рукопожатие.
//
// Возвращаемое значение:
//  ТестируемоеПриложение
Функция ПодключитьсяККлиентуТестирования(Контекст, Таймаут = 240) Экспорт

	Приложение = Новый ТестируемоеПриложение(Контекст.АдресКлиента, Контекст.Порт);
	КрайнийСрок = ТекущаяУниверсальнаяДатаВМиллисекундах() + Таймаут * 1000;
	ПоследняяОшибка = "";
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() <= КрайнийСрок Цикл
		Попытка
			Приложение.УстановитьСоединение();
			Возврат Приложение;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;

	ВызватьИсключение "Нет подключения к клиенту тестирования: " + ПоследняяОшибка;

КонецФункции

// Выполняет серверный шаг теста в проверяемой базе.
//
// Текст шага - текстовый макет обработки этого теста: сборщик делает макет из каждого файла
// каталога server рядом со сценарием, поэтому шаги разных тестов не пересекаются.
//
// Параметры:
//  Контекст  - Структура - см. Контекст.
//  Имя       - Строка - имя макета (оно же имя процедуры шага или файла общей фикстуры).
//  Параметры - Структура, Неопределено - значения параметров шага; каждое объявляется перед
//              его текстом. Допустимы строка, число, булево и Неопределено.
//
// Возвращаемое значение:
//  Произвольный - значение переменной «Результат» серверного кода, разобранное из JSON.
Функция ВыполнитьШаг(Контекст, Имя, Параметры = Неопределено) Экспорт

	Попытка
		Текст = Обработки[Контекст.Обработка].ПолучитьМакет(Имя).ПолучитьТекст();
	Исключение
		ВызватьИсключение "В обработке " + Контекст.Обработка + " нет макета серверного шага «"
			+ Имя + "»: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат ВыполнитьКод(Контекст, ОбъявленияПараметров(Параметры) + Текст);

КонецФункции

// Выполняет произвольный серверный код проверяемой базы через Dbg_Executor.
//
// Параметры:
//  Контекст - Структура - см. Контекст.
//  Код      - Строка - код на встроенном языке; его переменная «Результат» возвращается.
//
// Возвращаемое значение:
//  Произвольный - значение переменной «Результат», разобранное из JSON.
Функция ВыполнитьКод(Контекст, Код) Экспорт

	Настройки = НастройкиСервиса(Контекст);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Новый Структура("Код", Код));

	Запрос = Новый HTTPЗапрос(Настройки.Путь + "/hs/dbg_executor/exec/x");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("Authorization", "Basic " + Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(
		Настройки.Пользователь + ":" + Настройки.Пароль, "UTF-8", Ложь)));
	Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);

	Соединение = Новый HTTPСоединение(Настройки.Хост, Настройки.Порт, , , , 300);
	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	Тело = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Сервис выполнения ответил HTTP " + Ответ.КодСостояния + ": " + Лев(Тело, 300);
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело);
	Разобранное = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();

	Если ТипЗнч(Разобранное) = Тип("Структура") И Разобранное.Свойство("Результат") Тогда
		Возврат Разобранное.Результат;
	КонецЕсли;

	ВызватьИсключение "Сервис выполнения не вернул «Результат»: " + Лев(Тело, 300);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объявления параметров перед текстом шага.
//
// Параметры:
//  Параметры - Структура, Неопределено - значения параметров шага.
//
// Возвращаемое значение:
//  Строка - строки вида «Имя = значение;» или пустая строка.
Функция ОбъявленияПараметров(Параметры)

	Если Параметры = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Параметр Из Параметры Цикл
		Строки.Добавить(Параметр.Ключ + " = " + Литерал(Параметр.Значение) + ";");
	КонецЦикла;

	Возврат ?(Строки.Количество() = 0, "", СтрСоединить(Строки, Символы.ПС) + Символы.ПС);

КонецФункции

// Литерал значения параметра на встроенном языке.
//
// Параметры:
//  Значение - Строка, Число, Булево, Неопределено - значение параметра.
//
// Возвращаемое значение:
//  Строка
Функция Литерал(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Строки = СтрРазделить(СтрЗаменить(СтрЗаменить(Значение, Символы.ВК, ""), """", """"""), Символы.ПС);
		Возврат """" + СтрСоединить(Строки, Символы.ПС + "|") + """";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧГ=0");
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Истина", "Ложь");
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;

	ВызватьИсключение "Параметр шага типа «" + Строка(ТипЗнч(Значение))
		+ "» передать нельзя: допустимы строка, число, булево и Неопределено";

КонецФункции

// Параметры обращения к сервису: адрес публикации проверяемой базы приходит параметром
// запуска, учётные данные читаются из .dev.env проекта (в командную строку они не попадают).
//
// Параметры:
//  Контекст - Структура - см. Контекст.
//
// Возвращаемое значение:
//  Структура - Хост, Порт, Путь, Пользователь, Пароль.
Функция НастройкиСервиса(Контекст)

	Если Контекст.Настройки <> Неопределено Тогда
		Возврат Контекст.Настройки;
	КонецЕсли;

	Значения = ЗначенияНастроекПроекта(Контекст.КореньПроекта + "/.dev.env");

	Адрес = Контекст.АдресПубликации;
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = Значения.Получить("INFOBASE_PUBLISH_URL");
	КонецЕсли;
	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Не задан адрес публикации проверяемой базы: элемент параметра запуска"
			+ " или INFOBASE_PUBLISH_URL в .dev.env";
	КонецЕсли;

	Остаток = Адрес;
	Позиция = СтрНайти(Остаток, "://");
	Если Позиция > 0 Тогда
		Остаток = Сред(Остаток, Позиция + 3);
	КонецЕсли;

	Путь = "";
	Позиция = СтрНайти(Остаток, "/");
	Если Позиция > 0 Тогда
		Путь = Сред(Остаток, Позиция);
		Остаток = Лев(Остаток, Позиция - 1);
	КонецЕсли;

	Порт = 80;
	Позиция = СтрНайти(Остаток, ":");
	Если Позиция > 0 Тогда
		Порт = Число(Сред(Остаток, Позиция + 1));
		Остаток = Лев(Остаток, Позиция - 1);
	КонецЕсли;

	Контекст.Настройки = Новый Структура("Хост, Порт, Путь, Пользователь, Пароль",
		Остаток, Порт, СокрП(Путь), Значения.Получить("IB_USER"), Значения.Получить("IB_PASSWORD"));

	Возврат Контекст.Настройки;

КонецФункции

// Читает файл настроек проекта «ключ=значение»; значение в парных кавычках раскавычивается.
//
// Параметры:
//  Путь - Строка - путь к файлу.
//
// Возвращаемое значение:
//  Соответствие - ключ (Строка) - значение (Строка).
Функция ЗначенияНастроекПроекта(Путь)

	Значения = Новый Соответствие;

	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");  // noqa: BSL188
	Строка = Чтение.ПрочитатьСтроку();
	Пока Строка <> Неопределено Цикл
		Очищенная = СокрЛП(Строка);
		Позиция = СтрНайти(Очищенная, "=");
		Если Позиция > 1 И НЕ СтрНачинаетсяС(Очищенная, "#") Тогда
			Значение = СокрЛП(Сред(Очищенная, Позиция + 1));
			Кавычка = Лев(Значение, 1);
			Если СтрДлина(Значение) >= 2 И (Кавычка = """" ИЛИ Кавычка = "'") И Прав(Значение, 1) = Кавычка Тогда
				Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
			КонецЕсли;
			Значения.Вставить(СокрЛП(Лев(Очищенная, Позиция - 1)), Значение);
		КонецЕсли;
		Строка = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Значения;

КонецФункции

// Возвращает элемент параметра запуска по индексу; разделитель - «|».
//
// Параметры:
//  Индекс - Число - позиция, 0 - роль сеанса.
//
// Возвращаемое значение:
//  Строка
Функция Элемент(Индекс)

	Части = СтрРазделить(ПараметрЗапуска, "|");
	Возврат ?(Части.Количество() > Индекс, СокрЛП(Части[Индекс]), "");

КонецФункции

#КонецОбласти
