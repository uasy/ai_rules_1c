// Модуль управляемого приложения тестового расширения - точка входа прогона.
//
// Сеанс менеджера тестирования запускается ключом /TestManager с параметром
// "УИМенеджер|<порт>|<адрес клиента>|<файл протокола>|<корень проекта>|<публикация>|<тест>".
// Формы у сценариев нет: код теста - модуль менеджера обработки теста в расширении, а имя
// теста приходит параметром запуска.

&После("ПриНачалеРаботыСистемы")
Процедура Т_ПриНачалеРаботыСистемы()

	Если СтрНачинаетсяС(ПараметрЗапуска, "УИМенеджер") Тогда
		// В самом ПриНачалеРаботыСистемы система ещё не готова работать с окнами,
		// поэтому прогон начинается обработчиком ожидания.
		ПодключитьОбработчикОжидания("Т_ВыполнитьТест", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

// Обработчик ожидания: экспортная процедура модуля приложения без параметров
// (требование ПодключитьОбработчикОжидания глобального контекста).
Процедура Т_ВыполнитьТест() Экспорт

	Контекст = Т_Прогон.Контекст();

	Попытка
		Т_ВыполнитьТестПоИмени(Контекст);
	Исключение
		Т_Прогон.ЗаписатьШаг(Контекст, Ложь, "Прогон прерван: " + ОписаниеОшибки());
	КонецПопытки;

	Т_Прогон.ЗавершитьПрогон(Контекст);
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

// НАЧАЛО ДИСПЕТЧЕРА - раздел ниже целиком переписывает build-test-extension.py:
// по ветке на каждый собранный тест. Вычислить не используется: в безопасном режиме
// расширения он недоступен, а имена модулей известны на сборке.
Процедура Т_ВыполнитьТестПоИмени(Контекст)

	ВызватьИсключение "Тестовое расширение собрано без тестов";

КонецПроцедуры
// КОНЕЦ ДИСПЕТЧЕРА
