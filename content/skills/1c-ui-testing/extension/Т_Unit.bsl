// Прогон unit-проверки из сеанса менеджера тестирования: текст проверки лежит макетом
// «Проверка» в обработке этой проверки, исполняется в проверяемой базе через Dbg_Executor,
// а её шаги переписываются в общий протокол прогона.
//
// Тот же файл раннер умеет отправить в базу напрямую, без сеанса 1С, - это быстрый путь
// и внятная диагностика; этот модуль нужен, когда unit-проверку гонят тем же механизмом,
// что и сценарии клиента тестирования.

// Точка входа: имя обработки с макетом проверки подставляет диспетчер расширения.
//
// Параметры:
//  Контекст - Структура - см. Т_Прогон.Контекст.
Процедура ВыполнитьПроверку(Контекст) Экспорт

	Попытка
		Ответ = Т_Прогон.ВыполнитьШаг(Контекст, "Проверка");
	Исключение
		Т_Прогон.ЗаписатьШаг(Контекст, Ложь, "Проверка не выполнена: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Ответ) <> Тип("Структура") ИЛИ НЕ Ответ.Свойство("Шаги") Тогда
		Т_Прогон.ЗаписатьШаг(Контекст, Ложь,
			"Проверка вернула не протокол шагов: " + Лев(Строка(Ответ), 200));
		Возврат;
	КонецЕсли;

	Для Каждого Шаг Из Ответ.Шаги Цикл
		Успех = Ложь;
		Текст = "";
		Если ТипЗнч(Шаг) = Тип("Структура") Тогда
			Шаг.Свойство("Успех", Успех);
			Шаг.Свойство("Текст", Текст);
		КонецЕсли;
		Т_Прогон.ЗаписатьШаг(Контекст, Успех = Истина, Текст);
	КонецЦикла;

КонецПроцедуры
