// Читаем журнал регистрации по условиям в параметрах запроса.
// Данные журнала получаем через глобальный метод платформы ВыгрузитьЖурналРегистрации()
// и возвращаем в формате JSON.
//
// Тело запроса (JSON, все поля необязательны):
//   ДатаНачала        - Строка - начало интервала выборки, XML-представление даты
//                        (например "2026-08-30T00:00:00").
//   ДатаОкончания     - Строка - конец интервала выборки, тот же формат.
//   Уровень           - Строка
//                     - Массив из Строка - уровень(и) важности события:
//                       "Информация" | "Ошибка" | "Предупреждение" | "Примечание".
//   Событие           - Строка
//                     - Массив из Строка - имя(имена) события журнала регистрации,
//                       точное совпадение (например "Интеграция.ОбменСCRM.Ошибка").
//   Пользователь      - Строка
//                     - Массив из Строка - имя(имена) пользователя ИБ.
//   Метаданные        - Строка
//                     - Массив из Строка - полное имя объекта метаданных
//                       (например "Справочник.Контрагенты").
//   КоличествоСобытий - Число - максимальное число событий в ответе.
//                       По умолчанию 100, ограничение сверху - 5000.
//
// Тело ответа (JSON):
//   Количество - Число  - число событий в выборке.
//   События    - Массив - события журнала, каждое - объект с полями:
//                Дата, Уровень, Пользователь, Компьютер, ИмяПриложения, Событие,
//                Комментарий, Метаданные, Данные, Транзакция, СтатусТранзакции,
//                Сеанс, Соединение.
//   Порядок событий в выборке соответствует порядку, в котором их возвращает
//   ВыгрузитьЖурналРегистрации(), платформа не гарантирует сортировку по дате.
//
// HTTP-статусы: 200 - успех; 400 - некорректные параметры запроса;
//               500 - непредвиденная ошибка платформы при выгрузке.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - HTTP-запрос с телом в формате JSON (см. выше).
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с телом в формате JSON (см. выше).
//
Функция ЧтениеВызов(Запрос)

	Попытка
		ПараметрыЗапроса = РазобратьПараметрыЗапроса(Запрос.ПолучитьТелоКакСтроку());
	Исключение
		Возврат ОтветОшибка(400, ОписаниеОшибки());
	КонецПопытки;

	Попытка
		СобытияЖурнала = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(СобытияЖурнала, ПараметрыЗапроса.Отбор, , , ПараметрыЗапроса.КоличествоСобытий);
	Исключение
		Возврат ОтветОшибка(500, ОписаниеОшибки());
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("Количество", СобытияЖурнала.Количество());
	Результат.Вставить("События", СобытияЖурналаВJSON(СобытияЖурнала));

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON(Результат));

	Возврат Ответ;

КонецФункции

// Разбирает тело HTTP-запроса (JSON) в отбор и ограничение выборки для
// ВыгрузитьЖурналРегистрации(). Пустое тело запроса даёт отбор без ограничений.
//
// Параметры:
//   ТелоЗапроса - Строка - тело HTTP-запроса в формате JSON.
//
// Возвращаемое значение:
//   Структура - со свойствами:
//     * Отбор            - Структура - отбор в формате ВыгрузитьЖурналРегистрации().
//     * КоличествоСобытий - Число     - ограничение выборки (1 - 5000).
//
Функция РазобратьПараметрыЗапроса(ТелоЗапроса)

	Отбор = Новый Структура;
	КоличествоСобытий = 100;

	Если Не ПустаяСтрока(ТелоЗапроса) Тогда

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Параметры = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		ДатаНачала = ДатаГраницыОтбора(Параметры, "ДатаНачала");
		Если ДатаНачала <> Неопределено Тогда
			Отбор.Вставить("ДатаНачала", ДатаНачала);
		КонецЕсли;

		ДатаОкончания = ДатаГраницыОтбора(Параметры, "ДатаОкончания");
		Если ДатаОкончания <> Неопределено Тогда
			Отбор.Вставить("ДатаОкончания", ДатаОкончания);
		КонецЕсли;

		Если ДатаНачала <> Неопределено И ДатаОкончания <> Неопределено И ДатаНачала > ДатаОкончания Тогда
			ВызватьИсключение "ДатаНачала больше ДатаОкончания.";
		КонецЕсли;

		Значение = Неопределено;

		Если Параметры.Свойство("Уровень", Значение) И Значение <> Неопределено Тогда
			Отбор.Вставить("Уровень", УровниЖурналаРегистрации(Значение));
		КонецЕсли;

		Если Параметры.Свойство("Событие", Значение) И Значение <> Неопределено Тогда
			Отбор.Вставить("Событие", МассивЗначенийОтбора(Значение));
		КонецЕсли;

		Если Параметры.Свойство("Пользователь", Значение) И Значение <> Неопределено Тогда
			Отбор.Вставить("Пользователь", МассивЗначенийОтбора(Значение));
		КонецЕсли;

		Если Параметры.Свойство("Метаданные", Значение) И Значение <> Неопределено Тогда
			Отбор.Вставить("Метаданные", МассивЗначенийОтбора(Значение));
		КонецЕсли;

		Если Параметры.Свойство("КоличествоСобытий", Значение) И Значение <> Неопределено Тогда
			КоличествоСобытий = Мин(Макс(Значение, 1), 5000);
		КонецЕсли;

	КонецЕсли;

	Возврат Новый Структура("Отбор, КоличествоСобытий", Отбор, КоличествоСобытий);

КонецФункции

// Извлекает и разбирает дату-границу интервала отбора из разобранного тела запроса.
//
// Параметры:
//   Параметры   - Структура - разобранное тело запроса (JSON).
//   ИмяСвойства - Строка    - имя свойства ("ДатаНачала" или "ДатаОкончания").
//
// Возвращаемое значение:
//   Дата - если свойство задано и не пусто.
//   Неопределено - если свойство отсутствует или пусто.
//
Функция ДатаГраницыОтбора(Параметры, ИмяСвойства)

	Значение = Неопределено;
	Если Параметры.Свойство(ИмяСвойства, Значение) И ЗначениеЗаполнено(Значение) Тогда
		Возврат XMLЗначение(Тип("Дата"), Значение);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Приводит представление(я) уровня события из JSON к массиву значений
// перечисления УровеньЖурналаРегистрации.
//
// Параметры:
//   Уровни - Строка           - одно представление уровня.
//          - Массив из Строка - несколько представлений уровня (условие ИЛИ).
//            Допустимые значения: "Информация" | "Ошибка" | "Предупреждение" |
//            "Примечание".
//
// Возвращаемое значение:
//   Массив из УровеньЖурналаРегистрации
//
Функция УровниЖурналаРегистрации(Уровни)

	Результат = Новый Массив;

	Для Каждого Представление Из МассивЗначенийОтбора(Уровни) Цикл
		Если ВРег(Представление) = ВРег("Информация") Тогда
			Результат.Добавить(УровеньЖурналаРегистрации.Информация);
		ИначеЕсли ВРег(Представление) = ВРег("Ошибка") Тогда
			Результат.Добавить(УровеньЖурналаРегистрации.Ошибка);
		ИначеЕсли ВРег(Представление) = ВРег("Предупреждение") Тогда
			Результат.Добавить(УровеньЖурналаРегистрации.Предупреждение);
		ИначеЕсли ВРег(Представление) = ВРег("Примечание") Тогда
			Результат.Добавить(УровеньЖурналаРегистрации.Примечание);
		Иначе
			ВызватьИсключение СтрШаблон("Недопустимое значение Уровень: ""%1"".", Представление);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Приводит значение параметра отбора из JSON (строка или массив строк) к массиву,
// как того ожидает структура отбора ВыгрузитьЖурналРегистрации().
//
// Параметры:
//   Значение - Строка           - одно значение отбора.
//            - Массив из Строка - несколько значений отбора (условие ИЛИ).
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция МассивЗначенийОтбора(Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	МассивЗначений = Новый Массив;
	МассивЗначений.Добавить(Значение);

	Возврат МассивЗначений;

КонецФункции

// Преобразует таблицу событий журнала регистрации в массив структур для JSON-ответа.
// Из всех колонок ВыгрузитьЖурналРегистрации() отбираются только заведомо
// JSON-совместимые (Строка, Число) - тип Данные (Произвольный) намеренно не
// сериализуется напрямую, вместо него отдаётся его текстовое представление.
//
// Параметры:
//   СобытияЖурнала - ТаблицаЗначений - результат ВыгрузитьЖурналРегистрации().
//
// Возвращаемое значение:
//   Массив из Структура
//
Функция СобытияЖурналаВJSON(СобытияЖурнала)

	Результат = Новый Массив;

	Для Каждого СтрокаСобытия Из СобытияЖурнала Цикл
		Событие = Новый Структура;
		Событие.Вставить("Дата",             XMLСтрока(СтрокаСобытия.Дата));
		Событие.Вставить("Уровень",          Строка(СтрокаСобытия.Уровень));
		Событие.Вставить("Пользователь",     СтрокаСобытия.ИмяПользователя);
		Событие.Вставить("Компьютер",        СтрокаСобытия.Компьютер);
		Событие.Вставить("ИмяПриложения",    СтрокаСобытия.ИмяПриложения);
		Событие.Вставить("Событие",          СтрокаСобытия.Событие);
		Событие.Вставить("Комментарий",      СтрокаСобытия.Комментарий);
		Событие.Вставить("Метаданные",       СтрокаСобытия.ПредставлениеМетаданных);
		Событие.Вставить("Данные",           СтрокаСобытия.ПредставлениеДанных);
		Событие.Вставить("Транзакция",       СтрокаСобытия.Транзакция);
		Событие.Вставить("СтатусТранзакции", Строка(СтрокаСобытия.СтатусТранзакции));
		Событие.Вставить("Сеанс",            СтрокаСобытия.Сеанс);
		Событие.Вставить("Соединение",       СтрокаСобытия.Соединение);
		Результат.Добавить(Событие);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует HTTP-ответ с ошибкой в формате JSON.
//
// Параметры:
//   КодСостояния - Число  - HTTP-код ответа.
//   ТекстОшибки  - Строка - описание ошибки.
//
// Возвращаемое значение:
//   HTTPСервисОтвет
//
Функция ОтветОшибка(КодСостояния, ТекстОшибки)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON(Новый Структура("ОписаниеОшибки", ТекстОшибки)));

	Возврат Ответ;

КонецФункции

// Сериализует значение в строку JSON.
//
// Параметры:
//   Значение - Произвольный - значение, сериализуемое в JSON (любой тип,
//              поддерживаемый ЗаписатьJSON).
//
// Возвращаемое значение:
//   Строка
//
Функция СтрокаJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции
