// Выполняет код на встроенном языке 1С и возвращает значение переменной
// Результат в формате JSON. Инструмент для исследования данных без
// написания отдельных внешних обработок.
//
// Внимание: выполняет ЛЮБОЙ переданный код с правами пользователя,
// вызвавшего сервис (оператор Выполнить()). Только для отладки доверенным
// агентом, не для публикации внешним вызывающим сторонам.
//
// Тело запроса (JSON):
//   Код - Строка - код на встроенном языке 1С. Выполняется в общей области
//         видимости с переменной Результат; чтобы вернуть значение,
//         присвойте его этой переменной. Например:
//         "Результат = Справочники.Контрагенты.ПустаяСсылка();"
//         "Запрос = Новый Запрос(""ВЫБРАТЬ ...""); Результат = Запрос.Выполнить().Выгрузить();"
//
// Тело ответа (JSON):
//   Результат - Произвольный - значение переменной Результат после
//               выполнения кода, приведённое к JSON-совместимому виду
//               (см. ПривестиКJSON): ТаблицаЗначений - массив объектов по
//               колонкам; Структура, Соответствие - объект; Массив - массив;
//               Дата - строка в XML-представлении; ссылки и объекты 1С
//               (СправочникСсылка, ДокументОбъект, ПеречислениеСсылка и
//               т.п.) - строковое представление (ЗаписатьJSON не умеет
//               сериализовать их напрямую). Если код не присвоил
//               Результат - null.
//
// HTTP-статусы: 200 - код выполнен успешно (в т.ч. если Результат не
//               присвоен); 400 - тело запроса не JSON или не указано
//               свойство Код; 500 - ошибка компиляции или выполнения кода.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос - HTTP-запрос с телом в формате JSON (см. выше).
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с телом в формате JSON (см. выше).
//
Функция ВыполнениеВызов(Запрос)

	Попытка
		Код = КодИзТелаЗапроса(Запрос.ПолучитьТелоКакСтроку());
	Исключение
		Возврат ОтветОшибка(400, ОписаниеОшибки());
	КонецПопытки;

	Результат = Неопределено;

	Попытка
		Выполнить(Код);
	Исключение
		Возврат ОтветОшибка(500, ОписаниеОшибки());
	КонецПопытки;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON(Новый Структура("Результат", ПривестиКJSON(Результат))));

	Возврат Ответ;

КонецФункции

// Извлекает код на встроенном языке из тела HTTP-запроса (JSON).
//
// Параметры:
//   ТелоЗапроса - Строка - тело HTTP-запроса в формате JSON: {"Код": "..."}.
//
// Возвращаемое значение:
//   Строка - код на встроенном языке 1С.
//
Функция КодИзТелаЗапроса(ТелоЗапроса)

	Если ПустаяСтрока(ТелоЗапроса) Тогда
		ВызватьИсключение "Пустое тело запроса. Ожидается JSON вида {""Код"": ""...""}.";
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
	Тело = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Код = "";
	Если Не Тело.Свойство("Код", Код) Или Не ЗначениеЗаполнено(Код) Тогда
		ВызватьИсключение "Не указано свойство ""Код"" в теле запроса.";
	КонецЕсли;

	Возврат Код;

КонецФункции

// Рекурсивно приводит значение произвольного типа к виду, безопасно
// сериализуемому ЗаписатьJSON(). Ссылки и объекты 1С (СправочникСсылка,
// ДокументОбъект, ПеречислениеСсылка и т.п.), для которых нет прямой
// JSON-сериализации, заменяются их строковым представлением.
//
// Параметры:
//   Значение - Произвольный - значение любого типа 1С.
//
// Возвращаемое значение:
//   Произвольный - Строка, Число, Булево, Неопределено, Массив или
//   Структура, составленные рекурсивно из значений того же вида.
//
Функция ПривестиКJSON(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;

	ИначеЕсли ТипЗнч(Значение) = Тип("Строка")
		Или ТипЗнч(Значение) = Тип("Число")
		Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;

	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);

	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПривестиКJSON(Элемент));
		КонецЦикла;
		Возврат Результат;

	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(Строка(КлючИЗначение.Ключ), ПривестиКJSON(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;

	ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
		Возврат ТаблицуЗначенийВJSON(Значение);

	Иначе
		Возврат Строка(Значение);

	КонецЕсли;

КонецФункции

// Приводит таблицу значений к массиву структур (строка -> {колонка: значение})
// для JSON-ответа. Значения колонок приводятся рекурсивно через ПривестиКJSON.
//
// Параметры:
//   Таблица - ТаблицаЗначений - произвольная таблица значений.
//
// Возвращаемое значение:
//   Массив из Структура
//
Функция ТаблицуЗначенийВJSON(Таблица)

	Результат = Новый Массив;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтруктураСтроки = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			СтруктураСтроки.Вставить(Колонка.Имя, ПривестиКJSON(СтрокаТаблицы[Колонка.Имя]));
		КонецЦикла;
		Результат.Добавить(СтруктураСтроки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует HTTP-ответ с ошибкой в формате JSON.
//
// Параметры:
//   КодСостояния - Число  - HTTP-код ответа.
//   ТекстОшибки  - Строка - описание ошибки.
//
// Возвращаемое значение:
//   HTTPСервисОтвет
//
Функция ОтветОшибка(КодСостояния, ТекстОшибки)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON(Новый Структура("ОписаниеОшибки", ТекстОшибки)));

	Возврат Ответ;

КонецФункции

// Сериализует значение в строку JSON.
//
// Параметры:
//   Значение - Произвольный - значение, сериализуемое в JSON (любой тип,
//              поддерживаемый ЗаписатьJSON).
//
// Возвращаемое значение:
//   Строка
//
Функция СтрокаJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции
